{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tgmsc-placement-assistant",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tgmsc-placement",
      "database_id": "75ef4e51-4118-4870-95b8-8b375e210e0e",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "tgmsc-placement-assistant"
  },
  "observability": {
    "enabled": true
  }
}
